<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Daily Worker Last Week Adjustment — List                         -->
    <!-- (multiple rows per employee/week are allowed and summed          -->
    <!--  automatically when the weekly Excel report is generated)        -->
    <!-- ================================================================ -->
    <record id="view_daily_payroll_adjustment_list" model="ir.ui.view">
        <field name="name">daily.payroll.adjustment.list</field>
        <field name="model">daily.payroll.adjustment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id"/>
                <field name="week_date" options="{'min_precision': 'days'}"/>
                <field name="calc_type"/>
                <field name="quantity"/>
                <field name="amount" sum="Total" readonly="1"/>
                <field name="date"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_daily_payroll_adjustment_form" model="ir.ui.view">
        <field name="name">daily.payroll.adjustment.form</field>
        <field name="model">daily.payroll.adjustment</field>
        <field name="arch" type="xml">
            <form string="Daily Worker Last Week Adjustment">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="week_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="calc_type"/>
                            <field name="quantity"/>
                            <field name="amount" readonly="1"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Reason (optional)…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_daily_payroll_adjustment_search" model="ir.ui.view">
        <field name="name">daily.payroll.adjustment.search</field>
        <field name="model">daily.payroll.adjustment</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="week_date"/>
                <field name="calc_type"/>
                <filter string="Day Count" name="filter_day" domain="[('calc_type', '=', 'day')]"/>
                <filter string="Hour" name="filter_hour" domain="[('calc_type', '=', 'hour')]"/>
                
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Week" name="group_week" context="{'group_by': 'week_date'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'calc_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_daily_payroll_adjustment" model="ir.actions.act_window">
        <field name="name">Daily Worker Last Week Adjustment</field>
        <field name="res_model">daily.payroll.adjustment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_week': 1}</field>
        <field name="help">
            Record any number of last-week adjustment entries per daily-wage
            employee. Pick Day Count and enter a number of days (amount =
            days × daily wage) or Hour and enter a number of hours (amount =
            hours × daily wage ÷ 8). All entries for the same employee/week
            are summed automatically and added into that week's Grand Total
            in the Weekly Payroll Excel report.
        </field>
    </record>

</odoo>
