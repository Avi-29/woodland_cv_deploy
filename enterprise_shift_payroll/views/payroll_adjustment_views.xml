<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Payroll Adjustment — List                                         -->
    <!-- (multiple rows per employee/month are allowed and summed          -->
    <!--  automatically when payslips are computed)                       -->
    <!-- ================================================================ -->
    <record id="view_payroll_adjustment_list" model="ir.ui.view">
        <field name="name">payroll.adjustment.list</field>
        <field name="model">payroll.adjustment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
            <header>
             <button string="Last Month/Penalty/Advance"
                            type="action"
                            name="%(action_last_month_penalty_advance_wizard)d"
                            class="btn-secondary"
                            display="always"/>
            </header>
                <field name="employee_id"/>
                <field name="payroll_month" options="{'min_precision': 'months'}"/>
                <field name="adjustment_type"/>
                <field name="last_month_days" invisible="adjustment_type != 'last_month'"/>
                <field name="penalty_days" invisible="adjustment_type != 'penalty'"/>
                <field name="amount" sum="Total" readonly="adjustment_type == 'last_month'"/>
                <field name="pending_penalty" invisible="adjustment_type != 'penalty'"/>
                <field name="pending_advance" invisible="adjustment_type != 'advance'"/>
                <field name="date"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_adjustment_form" model="ir.ui.view">
        <field name="name">payroll.adjustment.form</field>
        <field name="model">payroll.adjustment</field>
        <field name="arch" type="xml">
            <form string="Payroll Adjustment">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="payroll_month" options="{'min_precision': 'months'}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="adjustment_type"/>
                            <field name="last_month_days" invisible="adjustment_type != 'last_month'"/>
                            <field name="penalty_days" invisible="adjustment_type != 'penalty'"/>
                            <field name="amount" readonly="adjustment_type == 'last_month'"/>
                            <field name="pending_penalty" invisible="adjustment_type != 'penalty'"/>
                            <field name="pending_advance" invisible="adjustment_type != 'advance'"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Reason (optional)…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payroll_adjustment_search" model="ir.ui.view">
        <field name="name">payroll.adjustment.search</field>
        <field name="model">payroll.adjustment</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="payroll_month"/>
                <field name="adjustment_type"/>
                <filter string="Last Month Due" name="filter_last_month"
                        domain="[('adjustment_type', '=', 'last_month')]"/>
                <filter string="Penalty" name="filter_penalty"
                        domain="[('adjustment_type', '=', 'penalty')]"/>
                <filter string="Advance Payment" name="filter_advance"
                        domain="[('adjustment_type', '=', 'advance')]"/>
                
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Payroll Month" name="group_month" context="{'group_by': 'payroll_month'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'adjustment_type'}"/>
            
            </search>
        </field>
    </record>

    <record id="action_payroll_adjustment" model="ir.actions.act_window">
        <field name="name">Last Month / Penalty / Advance</field>
        <field name="res_model">payroll.adjustment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_month': 1}</field>
        <field name="help">
            Record any number of Last Month Due, Penalty, or Advance Payment
            entries per employee per month. When payslips are computed, all
            entries of the same type for that month are summed automatically —
            Last Month Due is added to net pay, Penalty and Advance Payment
            are deducted.
        </field>
    </record>

</odoo>
