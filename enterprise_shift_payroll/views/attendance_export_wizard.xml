<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard form view -->
    <record id="view_attendance_export_wizard_form" model="ir.ui.view">
        <field name="name">payroll.attendance.export.wizard.form</field>
        <field name="model">payroll.attendance.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Attendance Data">
                <group>
                    <field name="export_month" options="{'min_precision':'months'}"/>
                </group>
                <footer>
                    <button name="action_export_attendance"
                            string="Export Attendance"
                            type="object"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action that opens the wizard (attach to payslip list/form) -->
    <record id="action_open_attendance_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Attendance Data</field>
        <field name="res_model">payroll.attendance.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_attendance_export_wizard_form"/>
        <field name="target">new</field>
    </record>


</odoo>