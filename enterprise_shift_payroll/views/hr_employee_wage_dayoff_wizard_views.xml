<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Set / Change Wage Wizard                                          -->
    <!-- ================================================================ -->
    <record id="view_hr_employee_wage_change_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.wage.change.wizard.form</field>
        <field name="model">hr.employee.wage.change.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="mode" invisible="1"/>
                <sheet>
                    <group>
                        <field name="employee_id" readonly="1"/>
                        <field name="current_wage" invisible="mode == 'set'"/>
                        <field name="new_wage"/>
                        <field name="effective_date"
                               options="{'min_precision': 'months'}"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" name="action_confirm"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Change Day Off Wizard                                             -->
    <!-- ================================================================ -->
    <record id="view_hr_employee_dayoff_change_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.dayoff.change.wizard.form</field>
        <field name="model">hr.employee.dayoff.change.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id" readonly="1"/>
                        <field name="current_day_off"/>
                        <field name="new_day_off"/>
                        <field name="effective_date"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" name="action_confirm"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
