<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Bank Transfer Export Wizard – Form View
    ════════════════════════════════════════════════════════════════ -->
    <record id="view_payroll_bank_export_wizard_form" model="ir.ui.view">
        <field name="name">payroll.bank.export.wizard.form</field>
        <field name="model">payroll.bank.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Net Pay for Bank Transfer">
                <group>
                    <field name="export_month" options="{'min_precision':'months'}"/>
                </group>
                <footer>
                    <button name="action_export_bank_list"
                            string="Export"
                            type="object"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Action – opens the wizard in a dialog
    ════════════════════════════════════════════════════════════════ -->
    <record id="action_open_payroll_bank_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Net Pay for Bank Transfer</field>
        <field name="res_model">payroll.bank.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_bank_export_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
