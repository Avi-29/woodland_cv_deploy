<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Daily Worker Present/Absent Summary Wizard – Form View
    ════════════════════════════════════════════════════════════════ -->
    <record id="view_payroll_daily_worker_summary_wizard_form" model="ir.ui.view">
        <field name="name">payroll.daily.worker.summary.wizard.form</field>
        <field name="model">payroll.daily.worker.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Worker Present/Absent Summary">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate_report"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Action – opens the wizard in a dialog
    ════════════════════════════════════════════════════════════════ -->
    <record id="action_open_daily_worker_summary_wizard" model="ir.actions.act_window">
        <field name="name">Daily Worker Present/Absent Summary</field>
        <field name="res_model">payroll.daily.worker.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_daily_worker_summary_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
