<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_hr_approval_sheet_wizard_form" model="ir.ui.view">
    <field name="name">hr.approval.sheet.wizard.form</field>
    <field name="model">hr.approval.sheet.wizard</field>
    <field name="arch" type="xml">
        <form string="Approval Sheet Signatories">
            <p>Enter who signs each of the 4 slots on this Approval Sheet.</p>
            <group>
                <field name="sign_1"/>
                <field name="sign_2"/>
                <field name="sign_3"/>
                <field name="sign_4"/>
            </group>
            <footer>
                <button name="action_print_approval_sheet" type="object"
                        string="Print" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="action_hr_approval_sheet_wizard" model="ir.actions.act_window">
    <field name="name">Print Approval Sheet</field>
    <field name="res_model">hr.approval.sheet.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="model_hr_employee_approval"/>
    <field name="binding_type">action</field>
</record>

</odoo>
