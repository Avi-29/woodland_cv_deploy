<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_cron_process_raw_punces" model="ir.cron">
        <field name="name">ZK Raw Punches Processor</field>
        <field name="model_id" ref="model_zk_attendance_processor"/>
        <field name="state">code</field>
        <field name="code">model.process_raw_punches()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_auto_checkout_attendance" model="ir.cron">
        <field name="name">Auto Checkout Long Attendance</field>
        <field name="model_id" ref="model_zk_attendance_processor"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_checkout_long_attendance()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>