<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         Section List
    ============================================================ -->
    <record id="view_hr_section_tree" model="ir.ui.view">
        <field name="name">hr.section.tree</field>
        <field name="model">hr.section</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Section Form
    ============================================================ -->
    <record id="view_hr_section_form" model="ir.ui.view">
        <field name="name">hr.section.form</field>
        <field name="model">hr.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="department_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Employees" name="employees">
                            <field name="employee_ids" readonly="1">
                                <list>
                                    <field name="zk_badge_no"/>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="job_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Section Search
    ============================================================ -->
    <record id="view_hr_section_search" model="ir.ui.view">
        <field name="name">hr.section.search</field>
        <field name="model">hr.section</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_by_department" string="Department"
                        context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Action
    ============================================================ -->
    <record id="action_hr_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">hr.section</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
