                            <td class="label">Mobile No</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                        </tr>

                        <tr>
                            <td class="num">10.</td>
                            <td class="label" style="white-space: normal; line-height: 1.2;">
                                10. Section where<br/>recruitment is required
                            </td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                            <td class="num">20.</td>
                            <td class="label">Introducer</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                        </tr>

                        <tr>
                            <td class="num">11.</td>
                            <td class="label">Applied Position</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                            <td class="num">21.</td>
                            <td class="label">Approved Position</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                        </tr>

                        <tr>
                            <td class="num">12.</td>
                            <td class="label">Applied Salary</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                            <td class="num">22.</td>
                            <td class="label">Approved Salary</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                        </tr>

                        <tr>
                            <td class="num">13.</td>
                            <td class="label">Examination Result</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                            <td class="num"></td>
                            <td class="label">Joining Date</td>
                            <td class="colon">:</td>
                            <td class="value">
                                <!-- Insert Field Here -->
                            </td>
                        </tr>
                    </table>

                    <!-- Signatory labels are dynamic: default to the standard 4
                         roles below, but can be overridden per print run via the
                         "Print Approval Sheet" wizard, since different employees/
                         sections need different people's approval. See
                         report.woodland_attendance_extend.report_approval_sheet
                         (models/report_approval_sheet.py) for the defaults.
                         No box/border around them - just a plain rule line above
                         each name, matching a physically-signed paper form. -->
                    <table class="table table-borderless w-100 mt-5" style="margin-top:170px; table-layout: fixed;">
                        <tr>
                            <td class="text-center border-top pt-2 fw-bold" t-esc="approval_sign_1 or 'Sr. Manager'"/>
                            <td class="text-center border-top pt-2 fw-bold" t-esc="approval_sign_2 or 'D.G.M (Production)'"/>
                            <td class="text-center border-top pt-2 fw-bold" t-esc="approval_sign_3 or 'General Manager'"/>
                            <td class="text-center border-top pt-2 fw-bold" t-esc="approval_sign_4 or 'Managing Director'"/>
                        </tr>
                    </table>

                </div>
            </div>
        </t>
    </template>

    <record id="paperformat_approval_sheet" model="report.paperformat">
        <field name="name">Approval Note Sheet A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_approval_sheet" model="ir.actions.report">
        <field name="name">Employment Approval Note Sheet</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">woodland_attendance_extend.report_approval_sheet</field>
        <field name="report_file">woodland_attendance_extend.report_approval_sheet</field>
        <field name="print_report_name">'Approval Sheet - %s' % (object.name)</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_approval_sheet"/>
    </record>

</odoo>