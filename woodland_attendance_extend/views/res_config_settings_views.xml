<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_attendance_extend" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.woodland.attendance.extend
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <div class="app_settings_block" data-string="Attendance Rules"
                     string="Attendance Rules" data-key="hr_attendance_extend"
                     groups="hr_attendance.group_hr_attendance_manager">
                    <h2>Late Arrival</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="attendance_late_grace_minutes"
                                       string="Late Grace Period (minutes)"/>
                                <div class="text-muted">
                                    Check-ins after shift start + this many minutes are marked late.
                                </div>
                                <div class="content-group">
                                    <field name="attendance_late_grace_minutes" class="w-25"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="attendance_morning_late_grace_minutes"
                                       string="Morning-Shift Late Grace Period (minutes)"/>
                                <div class="text-muted">
                                    Used instead of the standard grace period when both the shift
                                    and the employee's department are flagged as Morning Shift.
                                </div>
                                <div class="content-group">
                                    <field name="attendance_morning_late_grace_minutes" class="w-25"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Auto-Checkout</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="attendance_auto_checkout_hours"
                                       string="Auto-Checkout After (hours)"/>
                                <div class="text-muted">
                                    An open attendance with no checkout for this many hours is
                                    automatically closed.
                                </div>
                                <div class="content-group">
                                    <field name="attendance_auto_checkout_hours" class="w-25"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="attendance_daily_night_auto_checkout_hours"
                                       string="Daily Worker / Night Shift (hours)"/>
                                <div class="text-muted">
                                    Overrides the default above when the employee is a Daily
                                    Worker and the attendance's shift crosses midnight (Night Shift).
                                </div>
                                <div class="content-group">
                                    <field name="attendance_daily_night_auto_checkout_hours" class="w-25"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
