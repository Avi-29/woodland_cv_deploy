<odoo>
    <record id="group_hide_unwanted" model="res.groups">
        <field name="name">Hide Unwanted Features</field>
        <field name="comment">Hide Unwanted Menu</field>
    </record>

    <!-- Top level of the Employees access dropdown, above HR Administrator
         (which it implies). Only this group can Change Wage and Remove Late. -->
    <record id="group_hr_super_admin" model="res.groups">
        <field name="name">Super Admin</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">HR Administrator plus Change Wage and Remove Late.</field>
    </record>
</odoo>
