<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── ZK Device ─── -->
    <record id="view_zk_device_list" model="ir.ui.view">
        <field name="name">zk.device.list</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <list string="ZKTeco Devices" decoration-success="state == 'online'"
                  decoration-muted="state == 'offline'" decoration-warning="state == 'unknown'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="ip_address"/>
                <field name="location"/>
                <field name="device_model"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'online'"
                       decoration-danger="state == 'offline'"
                       decoration-warning="state == 'unknown'"/>
                <field name="last_activity"/>
                <field name="last_heartbeat"/>
                <field name="attendance_count" string="Punches"/>
            </list>
        </field>
    </record>

    <record id="view_zk_device_form" model="ir.ui.view">
        <field name="name">zk.device.form</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <form string="ZKTeco Device">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="unknown,online,offline"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attendance" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="attendance_count" widget="statinfo" string="Punches"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Device Name"/></h1>
                    </div>
                    <group>
                        <group string="Device Info">
                            <field name="serial_number"/>
                            <field name="ip_address"/>
                            <field name="location"/>
                            <field name="device_model"/>
                            <field name="firmware_version" readonly="1"/>
                            <field name="push_version" readonly="1"/>
                        </group>
                        <group string="ADMS Settings">
                            <field name="timezone"/>
                            <field name="server_tz_offset"/>
                            <field name="heartbeat_interval"/>
                            <field name="realtime"/>
                        </group>
                    </group>
                    <group string="Activity">
                        <field name="last_activity" readonly="1"/>
                        <field name="last_heartbeat" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zk_device" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">zk.device</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
