<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zk_export_wizard_form" model="ir.ui.view">
        <field name="name">zk.attendance.export.wizard.form</field>
        <field name="model">zk.attendance.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Attendance Logs">
                <group invisible="state == 'done'">
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filters">
                        <field name="device_ids" widget="many2many_tags"/>
                        <field name="punch_type"/>
                        <field name="state_filter"/>
                    </group>
                    <group string="Output">
                        <field name="file_format"/>
                    </group>
                </group>

                <!-- Done state -->
                <group invisible="state == 'draft'">
                    <div class="alert alert-success" role="alert">
                        <i class="fa fa-check-circle me-1" title="export_count"/>
                        <strong><field name="export_count" readonly="1"/> records</strong> exported successfully.
                    </div>
                    <field name="export_file" filename="export_filename" widget="binary"
                           string="Download File"/>
                    <field name="export_filename" invisible="1"/>
                </group>

                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_export" type="object" string="Export"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_zk_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Attendance</field>
        <field name="res_model">zk.attendance.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
